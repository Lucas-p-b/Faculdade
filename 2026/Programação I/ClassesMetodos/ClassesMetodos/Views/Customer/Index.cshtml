@model List<Model.Customer>

@{
	ViewData["Title"] = "Customer List";
}

<a asp-controller="Customer" asp-action="Create">Novo Customer</a>

<table class="table table-striped table-responsive">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Email</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var customer in Model)
		{
			<tr>
				<td>@customer.Id</td>
				<td>@customer.FirstName</td>
				<td>@customer.Email</td>
				<td>
					<a asp-controller="Customer" 
					asp-action="Edit" 
					asp-route-id="@customer.Id">Edit</a> |
					<a asp-controller="Customer" 
					asp-action="Delete" 
					asp-route-id="@customer.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>