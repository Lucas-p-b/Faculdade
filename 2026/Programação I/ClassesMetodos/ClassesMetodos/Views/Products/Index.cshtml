@model List<Model.Product>

@{
	ViewData["Title"] = "Product List";
}

<a asp-controller="Products" asp-action="Create">Novo Produto</a>

<table class="table table-striped table-responsive">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Price</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model)
		{
			<tr>
				<td>@product.Id</td>
				<td>@product.Name</td>
				<td>@product.Price</td>
				<td>
					<a asp-controller="Products"
					   asp-action="Edit"
					   asp-route-id="@product.Id">Edit</a> |
					<a asp-controller="Products"
					   asp-action="Delete"
					   asp-route-id="@product.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>